<?xml version="1.0" encoding="utf-8"?>
<!-- Respostas automaticas aplicadas depois da imagem do Windows.
     Namespaces e fases pertencem ao formato do Windows Setup. -->
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Identidade do computador e fuso horario na fase de especializacao. -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <ComputerName>*</ComputerName>
      <TimeZone>E. South America Standard Time</TimeZone>
      <RegisteredOwner>Pichau</RegisteredOwner>
      <RegisteredOrganization>Pichau</RegisteredOrganization>
    </component>
  </settings>

  <!-- Primeiro uso: idioma, conta local e entrada automatica. -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <!-- Teclado e localidades em portugues do Brasil. -->
      <InputLocale>0416:00010416</InputLocale>
      <SystemLocale>pt-BR</SystemLocale>
      <UILanguage>pt-BR</UILanguage>
      <UserLocale>pt-BR</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral"
               versionScope="nonSxS">
      <!-- Telas omitidas na experiencia inicial e opcoes de protecao. -->
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <NetworkLocation>Other</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

      <!-- Conta local administrativa com os valores definidos abaixo. -->
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>Pichau</Name>
            <DisplayName>Pichau</DisplayName>
            <Description>Pichau</Description>
            <Group>Administrators</Group>
            <Password>
              <Value></Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <!-- Unico gatilho automatico: drivers e pos-processamento no primeiro logon. -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Executar Atualizar Drivers uma unica vez</Description>
          <CommandLine>powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%WINDIR%\Setup\Scripts\Iniciar-PrimeiroLogon.ps1"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>

      <!-- Dois logons automaticos para concluir a preparacao do computador. -->
      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>Pichau</Username>
        <LogonCount>2</LogonCount>
        <Password>
          <Value></Value>
          <PlainText>true</PlainText>
        </Password>
      </AutoLogon>
    </component>
  </settings>

</unattend>
